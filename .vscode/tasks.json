{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "python -m unittest discover -s app",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run local app",
      "type": "shell",
      "command": "python",
      "args": [
        "app/main.py"
      ],
      "options": {
        "env": {
          "PROFILE_STORE_PATH": "instance/local-profiles.db"
        }
      },
      "problemMatcher": []
    }
  ]
}
